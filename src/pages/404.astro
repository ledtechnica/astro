---
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — LED Technica" description="404 — no LED at this address.">
  <main class="relative z-10 mx-auto grid min-h-[70vh] max-w-3xl place-items-center px-6 pt-32 pb-12 lg:px-8">
    <div class="text-center">
      <div class="flex items-center justify-center gap-6">
        <span class="size-4 rounded-full bg-led-pink shadow-[0_0_18px_#ec4673]"></span>
        <span class="size-4 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
        <span class="size-4 rounded-full bg-led-cyan shadow-[0_0_18px_#2dd4d4]"></span>
      </div>
      <h1 class="gradient-text mt-8 font-display text-[clamp(5rem,15vw,9rem)] font-bold leading-none tracking-tight">
        404
      </h1>
      <p class="mt-4 font-display text-[1.4rem] font-semibold text-zinc-950 dark:text-white">
        That LED isn't lit.
      </p>
      <p class="mt-3 max-w-[40ch] mx-auto text-zinc-500 dark:text-zinc-400">
        The page you were looking for isn't here. It may have been renamed, retired, or
        — if you came in from an old Medium link — moved into the archive.
      </p>
      <div class="mt-8 flex items-center justify-center gap-2">
        <a href="/" class="inline-flex items-center gap-2 rounded-lg bg-zinc-950 px-3.5 py-2 text-sm/5 font-semibold text-white shadow-sm ring-1 ring-zinc-950/10 transition hover:bg-zinc-800 dark:bg-white dark:text-zinc-950 dark:ring-white/20 dark:hover:bg-zinc-200">
          Home
        </a>
        <a href="/archive/" class="inline-flex items-center gap-2 rounded-lg bg-transparent px-3.5 py-2 text-sm/5 font-semibold text-zinc-950 ring-1 ring-zinc-950/15 transition hover:bg-zinc-950/5 dark:text-white dark:ring-white/15 dark:hover:bg-white/5">
          Archive
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
