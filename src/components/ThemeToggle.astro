---
// Segmented 3-button theme control (light / system / dark).
// The buttons set data-theme-btn so the shared toggle script in BaseLayout
// can attach handlers + reflect active state via data-active.
---

<div
  role="group"
  aria-label="Theme"
  class="ml-1 inline-flex items-center gap-0.5 rounded-full border border-zinc-950/10 bg-white p-0.5 dark:border-white/10 dark:bg-zinc-900"
>
  <button
    type="button"
    data-theme-btn="light"
    aria-label="Light theme"
    class="grid size-7 place-items-center rounded-full text-zinc-500 transition data-[active=true]:bg-zinc-950 data-[active=true]:text-white dark:text-zinc-400 dark:data-[active=true]:bg-white dark:data-[active=true]:text-zinc-900"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-3.5">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
  </button>
  <button
    type="button"
    data-theme-btn="system"
    aria-label="System theme"
    class="grid size-7 place-items-center rounded-full text-zinc-500 transition data-[active=true]:bg-zinc-950 data-[active=true]:text-white dark:text-zinc-400 dark:data-[active=true]:bg-white dark:data-[active=true]:text-zinc-900"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-3.5">
      <rect x="3" y="4" width="18" height="13" rx="2"></rect>
      <path d="M8 21h8M12 17v4"></path>
    </svg>
  </button>
  <button
    type="button"
    data-theme-btn="dark"
    aria-label="Dark theme"
    class="grid size-7 place-items-center rounded-full text-zinc-500 transition data-[active=true]:bg-zinc-950 data-[active=true]:text-white dark:text-zinc-400 dark:data-[active=true]:bg-white dark:data-[active=true]:text-zinc-900"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-3.5">
      <path d="M21 13A9 9 0 1 1 11 3a7 7 0 0 0 10 10Z"></path>
    </svg>
  </button>
</div>
