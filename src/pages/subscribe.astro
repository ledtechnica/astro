---
import BaseLayout from "~/layouts/BaseLayout.astro";
import SubscribeForm from "~/components/SubscribeForm.astro";
---

<BaseLayout title="Subscribe — LED Technica" active="subscribe">
  <main class="relative z-10 mx-auto max-w-4xl px-6 pt-32 pb-12 lg:px-8">
    <section class="subscribe-glow rounded-2xl border border-zinc-950/10 p-10 dark:border-white/10">
      <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-led-cyan">Subscribe</span>
      <h1 class="mt-3 font-display text-[clamp(2rem,4vw,3rem)] font-semibold tracking-[-0.03em] text-balance">
        Get new posts in your inbox.
      </h1>
      <p class="mt-3 max-w-[60ch] text-zinc-500 dark:text-zinc-400">
        Plain text. No tracking pixels. Unsubscribe with one click. Drop your email below and
        you'll get a notification when a new post lands.
      </p>
      <div class="mt-8 max-w-md">
        <SubscribeForm />
      </div>
    </section>

    <section class="mt-12">
      <h2 class="font-display text-[1.4rem] font-semibold tracking-tight border-b border-zinc-950/10 pb-3 dark:border-white/10">
        Or follow the feed
      </h2>
      <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <a href="/rss.xml" class="flex flex-col gap-3 rounded-2xl border border-zinc-950/10 p-6 transition hover:border-zinc-950/20 dark:border-white/10 dark:hover:border-white/20">
          <span class="grid size-9 place-items-center rounded-xl bg-led-pink/15">
            <svg viewBox="0 0 24 24" fill="currentColor" class="size-4 text-led-pink">
              <path d="M4 4v3a13 13 0 0 1 13 13h3A16 16 0 0 0 4 4Zm0 7v3a6 6 0 0 1 6 6h3a9 9 0 0 0-9-9Zm2.5 6a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"></path>
            </svg>
          </span>
          <h3 class="font-display text-[1.05rem] font-semibold">RSS</h3>
          <p class="text-[13px] text-zinc-500 dark:text-zinc-400">Full-text RSS 2.0. Works with NetNewsWire, Feedbin, Reeder.</p>
          <code class="overflow-hidden text-ellipsis whitespace-nowrap rounded-md border border-zinc-950/10 bg-zinc-50 px-3 py-2 font-mono text-[11px] text-zinc-600 dark:border-white/10 dark:bg-zinc-900 dark:text-zinc-400">/rss.xml</code>
        </a>
        <a href="/sitemap-index.xml" class="flex flex-col gap-3 rounded-2xl border border-zinc-950/10 p-6 transition hover:border-zinc-950/20 dark:border-white/10 dark:hover:border-white/20">
          <span class="grid size-9 place-items-center rounded-xl bg-led-yellow/15">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4 text-led-yellow">
              <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </span>
          <h3 class="font-display text-[1.05rem] font-semibold">Sitemap</h3>
          <p class="text-[13px] text-zinc-500 dark:text-zinc-400">Every public URL on this site.</p>
          <code class="overflow-hidden text-ellipsis whitespace-nowrap rounded-md border border-zinc-950/10 bg-zinc-50 px-3 py-2 font-mono text-[11px] text-zinc-600 dark:border-white/10 dark:bg-zinc-900 dark:text-zinc-400">/sitemap-index.xml</code>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
