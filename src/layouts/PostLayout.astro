---
import BaseLayout from "./BaseLayout.astro";
import Tag from "~/components/Tag.astro";
import { formatDate, readingTime } from "~/lib/dates";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  rawContent?: string;
  headings?: MarkdownHeading[];
  mediumUrl?: string;
}

const {
  title,
  description,
  pubDate,
  tags = [],
  rawContent = "",
  headings = [],
  mediumUrl,
} = Astro.props;

const dateStr = formatDate(pubDate);
const iso = pubDate.toISOString();
const minutes = rawContent ? readingTime(rawContent) : null;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={`${title} — LED Technica`} description={description}>
  <main class="relative z-10 mx-auto max-w-6xl px-6 pt-32 lg:px-8">
    <header class="mx-auto max-w-2xl border-b border-zinc-950/10 pb-10 dark:border-white/10">
      <div class="mb-5 flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.06em] text-zinc-500 dark:text-zinc-400">
        <a href="/" class="hover:text-zinc-950 dark:hover:text-white">Articles</a>
        {tags[0] && (
          <>
            <span>/</span>
            <a href={`/archive/?tag=${encodeURIComponent(tags[0])}`} class="hover:text-zinc-950 dark:hover:text-white">
              {tags[0]}
            </a>
          </>
        )}
      </div>
      <h1 class="font-display text-[clamp(2.2rem,4.5vw,3.4rem)] font-semibold leading-[1.05] tracking-[-0.03em] text-balance">
        {title}
      </h1>
      {description && (
        <p class="mt-5 text-[1.2rem] text-zinc-500 dark:text-zinc-400 text-pretty max-w-[42ch]">
          {description}
        </p>
      )}
      <div class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[11px] uppercase tracking-[0.06em] text-zinc-500 dark:text-zinc-400">
        <time datetime={iso}>{dateStr}</time>
        {minutes && (
          <>
            <span class="size-1 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
            <span>{minutes} min read</span>
          </>
        )}
        {tags.map((t) => (
          <>
            <span class="size-1 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
            <Tag name={t} link={false} />
          </>
        ))}
      </div>
      {mediumUrl && (
        <p class="mt-5 font-mono text-[10.5px] uppercase tracking-[0.06em] text-zinc-500 dark:text-zinc-400">
          Originally published on
          <a href={mediumUrl} class="ml-1 text-zinc-950 hover:underline dark:text-white">Medium</a>
        </p>
      )}
    </header>

    <div class="mt-16 grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,2fr)_220px]">
      <article class="prose-led max-w-[680px] text-zinc-700 dark:text-zinc-300">
        <slot />
      </article>

      {tocHeadings.length > 0 && (
        <aside data-toc class="hidden lg:block">
          <div class="sticky top-24 text-[13px]">
            <p class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-zinc-500 dark:text-zinc-400">On this page</p>
            <ul class="mt-3 flex flex-col gap-2.5 border-l border-zinc-950/10 pl-4 dark:border-white/10">
              {tocHeadings.map((h) => (
                <li class:list={[h.depth === 3 && "pl-3"]}>
                  <a
                    href={`#${h.slug}`}
                    class="text-zinc-500 hover:text-zinc-950 data-[active=true]:text-led-cyan dark:text-zinc-400 dark:hover:text-white"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </main>
</BaseLayout>
