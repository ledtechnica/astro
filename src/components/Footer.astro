---
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer class="mx-auto mt-24 max-w-6xl border-t border-zinc-950/10 px-6 py-12 dark:border-white/10 lg:px-8">
  <div class="grid grid-cols-1 gap-8 md:grid-cols-[2fr_1fr_1fr_1fr]">
    <div>
      <Logo />
      <p class="mt-3 max-w-xs text-[13px] text-zinc-500 dark:text-zinc-400">
        A blog by Miray Kurtay. Notes on cloud, infrastructure, and the boring tools behind the scenes.
      </p>
    </div>
    <div>
      <h4 class="font-mono text-[10.5px] font-semibold uppercase tracking-[0.1em] text-zinc-950 dark:text-white">Read</h4>
      <ul class="mt-3 flex flex-col gap-2 text-[13px]">
        <li><a href="/" class="text-zinc-500 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white">Latest</a></li>
        <li><a href="/archive/" class="text-zinc-500 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white">Archive</a></li>
        <li><a href="/search/" class="text-zinc-500 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white">Search</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-mono text-[10.5px] font-semibold uppercase tracking-[0.1em] text-zinc-950 dark:text-white">Follow</h4>
      <ul class="mt-3 flex flex-col gap-2 text-[13px]">
        <li><a href="/rss.xml" class="text-zinc-500 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white">RSS</a></li>
        <li><a href="/subscribe/" class="text-zinc-500 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white">Subscribe</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-mono text-[10.5px] font-semibold uppercase tracking-[0.1em] text-zinc-950 dark:text-white">About</h4>
      <ul class="mt-3 flex flex-col gap-2 text-[13px]">
        <li><a href="/about/" class="text-zinc-500 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white">About this site</a></li>
        <li><a href="https://github.com/mkurtay/ledtechnica" class="text-zinc-500 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white">Source on GitHub</a></li>
      </ul>
    </div>
  </div>
  <div class="mt-10 flex items-center justify-between border-t border-zinc-950/10 pt-6 dark:border-white/10">
    <p class="font-mono text-[11px] uppercase tracking-[0.06em] text-zinc-500 dark:text-zinc-400">
      © {year} LED Technica · Built with Astro
    </p>
  </div>
</footer>
