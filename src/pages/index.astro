---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Logo from "~/components/Logo.astro";
import Tag from "~/components/Tag.astro";
import SubscribeForm from "~/components/SubscribeForm.astro";
import { formatDate, readingTime } from "~/lib/dates";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featured = posts[0];
const recent = posts.slice(1, 8);
const totalCount = posts.length;
---

<BaseLayout title="LED Technica" navFloating={true} active="home">
  <main class="relative z-10">
    <section data-logo-stage class="hero-halo relative mt-16 grid h-[360px] place-items-center px-6">
      <div class="pointer-events-none absolute top-6 left-0 right-0 mx-auto max-w-2xl text-center">
        <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-400">
          Est. 2011 · Cloud, infra, &amp; the boring tools behind it
        </span>
      </div>
      <Logo mode="hero" />
    </section>

    <div class="mx-auto max-w-6xl px-6 lg:px-8">
      <div class="text-center pt-2 pb-2">
        <h1 class="font-display text-[clamp(2.4rem,5vw,3.6rem)] font-semibold tracking-[-0.03em] leading-[1.05] text-zinc-950 dark:text-white text-balance">
          Notes from the rack room.
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-pretty text-[1.05rem] text-zinc-500 dark:text-zinc-400">
          Postmortems, pattern libraries, and field notes on running real systems in the cloud.
        </p>
        <div class="mt-7 flex items-center justify-center gap-2">
          <a href="/subscribe/" class="inline-flex items-center gap-2 rounded-lg bg-zinc-950 px-3.5 py-2 text-sm/5 font-semibold text-white shadow-sm ring-1 ring-zinc-950/10 transition hover:bg-zinc-800 dark:bg-white dark:text-zinc-950 dark:ring-white/20 dark:hover:bg-zinc-200">
            Subscribe
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-3.5"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a href="/archive/" class="inline-flex items-center gap-2 rounded-lg bg-transparent px-3.5 py-2 text-sm/5 font-semibold text-zinc-950 ring-1 ring-zinc-950/15 transition hover:bg-zinc-950/5 dark:text-white dark:ring-white/15 dark:hover:bg-white/5">
            Browse archive
          </a>
        </div>
      </div>

      {featured && (
        <section class="mt-20 grid grid-cols-1 gap-10 border-t border-zinc-950/10 pt-12 dark:border-white/10 md:grid-cols-[1.05fr_1fr] md:gap-12 md:items-center">
          <a href={`/posts/${featured.id}/`} class="group relative block aspect-[5/4] overflow-hidden rounded-2xl border border-zinc-950/10 bg-zinc-100 dark:border-white/10 dark:bg-zinc-900">
            <svg viewBox="0 0 500 400" class="absolute inset-0 size-full" preserveAspectRatio="xMidYMid slice">
              <defs>
                <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path d="M 20 0 L 0 0 0 20" fill="none" stroke="currentColor" stroke-width="0.5" class="text-zinc-950/[0.04] dark:text-white/[0.05]"/>
                </pattern>
                <radialGradient id="pinkGlow" cx="0.5" cy="0.5" r="0.5">
                  <stop offset="0%" stop-color="#ec4673" stop-opacity="0.9"/>
                  <stop offset="100%" stop-color="#ec4673" stop-opacity="0"/>
                </radialGradient>
                <radialGradient id="yellowGlow" cx="0.5" cy="0.5" r="0.5">
                  <stop offset="0%" stop-color="#f5c542" stop-opacity="0.9"/>
                  <stop offset="100%" stop-color="#f5c542" stop-opacity="0"/>
                </radialGradient>
                <radialGradient id="cyanGlow" cx="0.5" cy="0.5" r="0.5">
                  <stop offset="0%" stop-color="#2dd4d4" stop-opacity="0.9"/>
                  <stop offset="100%" stop-color="#2dd4d4" stop-opacity="0"/>
                </radialGradient>
              </defs>
              <rect width="500" height="400" fill="url(#grid)"/>
              <g stroke="currentColor" stroke-width="1.5" fill="none" class="text-zinc-950/30 dark:text-white/25">
                <path d="M40 200 L160 200 L160 100 L320 100"/>
                <path d="M160 200 L260 200 L260 300 L420 300"/>
                <path d="M260 200 L380 200"/>
              </g>
              <circle cx="320" cy="100" r="60" fill="url(#pinkGlow)"/>
              <circle cx="320" cy="100" r="18" fill="#ec4673"/>
              <circle cx="100" cy="140" r="60" fill="url(#yellowGlow)"/>
              <circle cx="100" cy="140" r="18" fill="#f5c542"/>
              <circle cx="420" cy="300" r="60" fill="url(#cyanGlow)"/>
              <circle cx="420" cy="300" r="18" fill="#2dd4d4"/>
            </svg>
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 transition group-hover:opacity-100"></div>
          </a>
          <div class="flex flex-col gap-4">
            <span class="inline-flex items-center gap-2 self-start font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-led-pink">
              <span class="size-2 rounded-full bg-led-pink shadow-[0_0_10px_#ec4673]"></span>
              Pinned · Featured
            </span>
            <h2 class="font-display text-[clamp(1.8rem,3.3vw,2.6rem)] font-semibold leading-[1.08] tracking-[-0.03em] text-zinc-950 dark:text-white text-balance">
              <a href={`/posts/${featured.id}/`} class="headline-link">{featured.data.title}</a>
            </h2>
            {featured.data.description && (
              <p class="text-[1.02rem] text-zinc-500 dark:text-zinc-400 text-pretty max-w-[52ch]">
                {featured.data.description}
              </p>
            )}
            <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-2">
              <span class="font-mono text-[11px] uppercase tracking-[0.06em] text-zinc-500 dark:text-zinc-400">
                {formatDate(featured.data.pubDate)}
              </span>
              <span class="size-1 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
              <span class="font-mono text-[11px] uppercase tracking-[0.06em] text-zinc-500 dark:text-zinc-400">
                {readingTime(featured.body)} min read
              </span>
            </div>
            {featured.data.tags.length > 0 && (
              <div class="mt-2 flex flex-wrap gap-2">
                {featured.data.tags.map((t) => <Tag name={t} />)}
              </div>
            )}
          </div>
        </section>
      )}

      <section class="mt-24">
        <div class="flex items-baseline justify-between gap-4 border-b border-zinc-950/10 pb-3 dark:border-white/10">
          <h2 class="text-base/6 font-semibold text-zinc-950 dark:text-white">All articles</h2>
          <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-zinc-500 dark:text-zinc-400">
            {totalCount} posts · sorted newest
          </span>
        </div>

        <ul class="flex flex-col">
          {recent.map((post, i) => (
            <li class:list={[
              "grid grid-cols-1 gap-2 py-7 md:grid-cols-[110px_1fr_auto] md:gap-8 md:items-baseline",
              i < recent.length - 1 && "border-b border-zinc-950/10 dark:border-white/10",
            ]}>
              <span class="font-mono text-[11px] uppercase tracking-[0.06em] text-zinc-500 dark:text-zinc-400">
                {formatDate(post.data.pubDate)}
              </span>
              <div class="flex flex-col gap-2">
                <h3 class="font-display text-[1.4rem] font-semibold tracking-[-0.022em] text-zinc-950 dark:text-white">
                  <a href={`/posts/${post.id}/`} class="headline-link">{post.data.title}</a>
                </h3>
                {post.data.description && (
                  <p class="max-w-[62ch] text-[0.96rem] text-zinc-500 dark:text-zinc-400 text-pretty">
                    {post.data.description}
                  </p>
                )}
                {post.data.tags.length > 0 && (
                  <div class="mt-1 flex flex-wrap gap-2">
                    {post.data.tags.map((t) => <Tag name={t} />)}
                  </div>
                )}
              </div>
              <span class="font-mono text-[10.5px] uppercase tracking-[0.06em] text-zinc-500 dark:text-zinc-400 md:text-right">
                {readingTime(post.body)} min · #{totalCount - i - 1}
              </span>
            </li>
          ))}
        </ul>

        {totalCount > 8 && (
          <div class="mt-10 flex items-center justify-center">
            <a href="/archive/" class="inline-flex items-center gap-2 rounded-lg bg-transparent px-3.5 py-2 text-sm/5 font-semibold text-zinc-950 ring-1 ring-zinc-950/15 transition hover:bg-zinc-950/5 dark:text-white dark:ring-white/15 dark:hover:bg-white/5">
              See all {totalCount} posts
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-3.5"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
          </div>
        )}
      </section>

      <section class="subscribe-glow mt-24 grid grid-cols-1 gap-10 rounded-2xl border border-zinc-950/10 p-10 md:grid-cols-2 md:items-center dark:border-white/10">
        <div>
          <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-led-cyan">The Newsletter</span>
          <h3 class="mt-3 font-display text-[1.55rem] font-semibold tracking-[-0.02em] text-zinc-950 dark:text-white">
            New posts in your inbox.
          </h3>
          <p class="mt-2 max-w-[42ch] text-[0.95rem] text-zinc-500 dark:text-zinc-400">
            Plain text. No tracking pixels. Unsubscribe with one click. RSS also available.
          </p>
        </div>
        <SubscribeForm helperText='Or grab the <a href="/rss.xml" class="text-zinc-950 underline-offset-2 hover:underline dark:text-white">RSS feed</a>' />
      </section>
    </div>
  </main>
</BaseLayout>
