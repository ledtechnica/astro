---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Tag from "~/components/Tag.astro";
import { formatDate, readingTime } from "~/lib/dates";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const byYear = posts.reduce<Record<number, typeof posts>>((acc, p) => {
  const y = p.data.pubDate.getUTCFullYear();
  (acc[y] ||= []).push(p);
  return acc;
}, {});
const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);

const tagCounts = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Archive — LED Technica" active="archive">
  <main class="relative z-10 mx-auto max-w-6xl px-6 pt-32 pb-12 lg:px-8">
    <header class="border-b border-zinc-950/10 pb-8 dark:border-white/10">
      <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-led-cyan">Archive</span>
      <h1 class="mt-3 font-display text-[clamp(2rem,4vw,3rem)] font-semibold tracking-[-0.03em]">
        Everything, grouped by year.
      </h1>
      <p class="mt-3 max-w-[60ch] text-zinc-500 dark:text-zinc-400">
        {posts.length} posts, newest {posts[0] ? formatDate(posts[0].data.pubDate) : "—"}.
      </p>
    </header>

    {tags.length > 0 && (
      <section class="mt-10">
        <p class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-zinc-500 dark:text-zinc-400">Filter by tag</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href="/archive/" class="inline-flex items-center gap-1.5 rounded-full bg-zinc-950 px-3 py-1.5 font-mono text-[11px] font-medium text-white dark:bg-white dark:text-zinc-950">
            All <span class="opacity-60">{posts.length}</span>
          </a>
          {tags.map(([name, n]) => (
            <span class="inline-flex items-center gap-1.5">
              <Tag name={name} size="md" />
              <span class="font-mono text-[10.5px] text-zinc-500 dark:text-zinc-400">{n}</span>
            </span>
          ))}
        </div>
      </section>
    )}

    <section class="mt-12 space-y-12">
      {years.map((y) => (
        <div>
          <h2 class="font-display text-[1.4rem] font-semibold tracking-tight border-b border-zinc-950/10 pb-2 dark:border-white/10">
            {y} <span class="ml-2 font-mono text-[11px] text-zinc-500 dark:text-zinc-400">{byYear[y].length} posts</span>
          </h2>
          <ul class="mt-4 flex flex-col">
            {byYear[y].map((post, i) => (
              <li class:list={[
                "grid grid-cols-1 gap-2 py-5 md:grid-cols-[110px_1fr_auto] md:gap-8 md:items-baseline",
                i < byYear[y].length - 1 && "border-b border-zinc-950/10 dark:border-white/10",
              ]}>
                <span class="font-mono text-[11px] uppercase tracking-[0.06em] text-zinc-500 dark:text-zinc-400">
                  {formatDate(post.data.pubDate)}
                </span>
                <div class="flex flex-col gap-1.5">
                  <a href={`/posts/${post.id}/`} class="headline-link font-display text-[1.15rem] font-semibold tracking-tight text-zinc-950 dark:text-white">
                    {post.data.title}
                  </a>
                  {post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5">
                      {post.data.tags.map((t) => <Tag name={t} />)}
                    </div>
                  )}
                </div>
                <span class="font-mono text-[10.5px] uppercase tracking-[0.06em] text-zinc-500 dark:text-zinc-400 md:text-right">
                  {readingTime(post.body)} min
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </main>
</BaseLayout>
