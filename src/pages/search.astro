---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .map((p) => ({
    title: p.data.title,
    description: p.data.description ?? "",
    slug: p.id,
    tags: p.data.tags,
    pubDate: p.data.pubDate.toISOString().slice(0, 10),
  }));
const postsJson = JSON.stringify(posts);
---

<BaseLayout title="Search — LED Technica" active="search">
  <main class="relative z-10 mx-auto max-w-3xl px-6 pt-32 pb-12 lg:px-8">
    <header class="border-b border-zinc-950/10 pb-8 dark:border-white/10">
      <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-led-cyan">Search</span>
      <h1 class="mt-3 font-display text-[clamp(2rem,4vw,3rem)] font-semibold tracking-[-0.03em]">
        Find a post.
      </h1>
    </header>

    <div class="mt-8 flex items-center gap-3 rounded-xl border border-zinc-950/15 bg-white px-5 py-4 shadow-sm dark:border-white/15 dark:bg-zinc-900/60">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5 text-zinc-500">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        id="q"
        type="text"
        placeholder="Search posts…"
        autocomplete="off"
        class="flex-1 border-0 bg-transparent text-[1.1rem] text-zinc-950 placeholder:text-zinc-500 focus:outline-none dark:text-white"
      />
    </div>

    <ul id="results" class="mt-8 flex flex-col gap-3"></ul>
    <p id="empty" class="mt-6 hidden font-mono text-[11px] uppercase tracking-[0.08em] text-zinc-500 dark:text-zinc-400">
      No matches.
    </p>
  </main>

  <script type="application/json" id="posts-data" set:html={postsJson}></script>
  <script>
    interface PostRow {
      title: string;
      description: string;
      slug: string;
      tags: string[];
      pubDate: string;
    }
    const dataEl = document.getElementById("posts-data");
    const posts: PostRow[] = dataEl?.textContent ? JSON.parse(dataEl.textContent) : [];
    const input = document.getElementById("q") as HTMLInputElement | null;
    const results = document.getElementById("results") as HTMLElement | null;
    const empty = document.getElementById("empty") as HTMLElement | null;

    function render(q: string): void {
      if (!results || !empty) return;
      const term = q.trim().toLowerCase();
      const matches = !term
        ? posts.slice(0, 12)
        : posts.filter((p) =>
            (p.title + " " + p.description + " " + p.tags.join(" ")).toLowerCase().includes(term),
          );
      results.innerHTML = matches
        .map(
          (p) => `
          <li class="rounded-xl border border-zinc-950/10 px-5 py-4 transition hover:border-zinc-950/20 dark:border-white/10 dark:hover:border-white/20">
            <a href="/posts/${p.slug}/" class="block">
              <p class="font-display text-[1.05rem] font-semibold text-zinc-950 dark:text-white">${p.title}</p>
              ${p.description ? `<p class="mt-1 text-[14px] text-zinc-500 dark:text-zinc-400">${p.description}</p>` : ""}
              <p class="mt-2 font-mono text-[10.5px] uppercase tracking-[0.08em] text-zinc-500 dark:text-zinc-400">${p.pubDate}${p.tags.length ? " · " + p.tags.join(" · ") : ""}</p>
            </a>
          </li>`,
        )
        .join("");
      empty.classList.toggle("hidden", matches.length > 0);
    }

    if (input) {
      input.addEventListener("input", () => render(input.value));
      input.focus();
    }
    render("");
  </script>
</BaseLayout>
